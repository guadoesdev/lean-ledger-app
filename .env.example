# Copy this file to .env and fill it in. Never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=a-long-random-string
PORT=3000

# AI meal logging
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
USDA_API_KEY=your-usda-fooddata-central-key
# Optional extra nutrition sources (used in this order after USDA):
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
# Ask the user to clarify when confidence is below this (0 to 1), and cap AI calls per user per hour:
CONFIDENCE_THRESHOLD=0.7
AI_HOURLY_LIMIT=30